<odoo>

<record id="yousign_request_remind_form" model="ir.ui.view">
    <field name="name">yousign_request_remind.form</field>
    <field name="model">yousign.request.remind</field>
    <field name="arch"  type="xml">
        <form>
            <p>This wizard will ask Yousign to send a reminder to all the selected requests.</p>
            <footer>
                <button type="object" name="run" string="Send Reminder" class="btn-primary"/>
                <button special="cancel" string="Cancel" class="btn-default"/>
            </footer>
        </form>
    </field>
</record>

<record id="yousign_request_remind_action" model="ir.actions.act_window">
    <field name="name">Send Reminder</field>
    <field name="res_model">yousign.request.remind</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="yousign_connector.model_yousign_request" />
    <field name="binding_view_types">list</field>
</record>

</odoo>
