msgid ""
"<code data-o-mail-quote=\"1\">\n"
"-- <br data-o-mail-quote=\"1\">\n"
"{{ object.company_id.name }}\n"
"</code>"
msgstr ""
"<code data-o-mail-quote=\"1\">\n"
"-- <br data-o-mail-quote=\"1\">\n"
"{{ object.company_id.name }}\n"
"</code>"

#. module: yousign_sale
#: model_terms:yousign.request.template,init_mail_body:yousign_sale.sale_sign_template
#: model_terms:yousign.request.template,remind_mail_body:yousign_sale.sale_sign_template
#: model_terms:yousign.request.template.notification,body:yousign_sale.sale_sign_template_notification_finished
msgid "Hello {{ object.partner_id.name }},"
msgstr "Bonjour {{ object.partner_id.name }},"

#. module: yousign_sale
#: model_terms:yousign.request.template,init_mail_body:yousign_sale.sale_sign_template
#: model_terms:yousign.request.template,remind_mail_body:yousign_sale.sale_sign_template
#: model_terms:yousign.request.template.notification,body:yousign_sale.sale_sign_template_notification_finished
msgid "Regards,"
msgstr "Cordialement,"

#. module: yousign_sale
#: model:yousign.request.template,remind_mail_subject:yousign_sale.sale_sign_template
msgid "Reminder - Sign request for quotation {{ object.name }}"
msgstr "Rappel - Demande de signature du devis {{ object.name }}"

#. module: yousign_sale
#: model_terms:ir.ui.view,arch_db:yousign_sale.view_order_form
msgid "Send Yousign Request"
msgstr "Envoyer une demande Yousign"

#. module: yousign_sale
#: model_terms:yousign.request.template.notification,body:yousign_sale.sale_sign_template_notification_finished
msgid "Thanks for your cooperation in this online signature process!"
msgstr ""
"Merci pour votre participation à ce processus de signature électronique !"

#. module: yousign_sale
#: model_terms:yousign.request.template.notification,body:yousign_sale.sale_sign_template_notification_finished
msgid ""
"The quotation {{ object.name }} for a total amount of {{ "
"format_amount(object.amount_untaxed, object.currency_id) }} without taxes "
"({{ format_amount(object.amount_total, object.currency_id) }} with taxes) "
"has been signed by all parties."
msgstr ""
"Le devis {{ object.name }} d'un montant total de {{ "
"format_amount(object.amount_untaxed, object.currency_id) }} HT ({{ "
"format_amount(object.amount_total, object.currency_id) }} TTC) a été signé "
"par toutes les parties."

#. module: yousign_sale
#: model_terms:yousign.request.template,init_mail_body:yousign_sale.sale_sign_template
msgid ""
"To approve this quotation, you should sign it by following the signature "
"process on Yousign: {yousignUrl|Access to quotation}."
msgstr ""
"Pour accepter ce devis, merci de le signer en suivant le processus de "
"signature sur Yousign : {yousignUrl|Accéder au devis}."

#. module: yousign_sale
#: model_terms:yousign.request.template,init_mail_body:yousign_sale.sale_sign_template
msgid ""
"We have prepared a quotation {{ object.name }} for a total amount of {{ "
"format_amount(object.amount_untaxed, object.currency_id) }} without taxes "
"({{ format_amount(object.amount_total, object.currency_id) }} with taxes)."
msgstr ""
"Nous avons préparé le devis {{ object.name }} d'un montant total de {{ "
"format_amount(object.amount_untaxed, object.currency_id) }} HT ({{ "
"format_amount(object.amount_total, object.currency_id) }} TTC)."

#. module: yousign_sale
#: model_terms:yousign.request.template,remind_mail_body:yousign_sale.sale_sign_template
msgid ""
"We recently sent you a quotation {{ object.name }} for a total amount of {{ "
"format_amount(object.amount_untaxed, object.currency_id) }} without taxes "
"({{ format_amount(object.amount_total, object.currency_id) }} with taxes)."
msgstr ""
"Nous vous avons récemment envoyé le devis {{ object.name }} d'un montant "
"total de {{ format_amount(object.amount_untaxed, object.currency_id) }} HT "
"({{ format_amount(object.amount_total, object.currency_id) }} TTC)."

#. module: yousign_sale
#: model_terms:yousign.request.template,remind_mail_body:yousign_sale.sale_sign_template
msgid ""
"We remind you that, in order to approve this quotation, you should sign it "
"by following the signature process on Yousign: {yousignUrl|Access to "
"quotation}."
msgstr ""
"Nous vous rappelons que, pour accepter ce devis, vous devez le signer en "
"suivant le processus de signature sur Yousign : {yousignUrl|Accéder au "
"devis}."

#. module: yousign_sale
#: model_terms:yousign.request.template.notification,body:yousign_sale.sale_sign_template_notification_finished
msgid ""
"You can now download the signed document: {yousignUrl|Access to signed "
"document}."
msgstr ""
"Vous pouvez dès à présent télécharger le document signé : "
"{yousignUrl|Accéder au document signé}."

#. module: yousign_sale
#: model:yousign.request.template.notification,subject:yousign_sale.sale_sign_template_notification_finished
msgid ""
"{{ object.company_id.name }} - Quotation {{ object.name }} signed by all "
"parties"
msgstr ""
"{{ object.company_id.name }} - Devis {{ object.name }} signé par toutes les "
"parties"

#. module: yousign_sale
#: model:yousign.request.template,init_mail_subject:yousign_sale.sale_sign_template
msgid ""
"{{ object.company_id.name }} - Sign request for quotation {{ object.name }}"
msgstr ""
"{{ object.company_id.name }} - Demande de signature du devis {{ object.name "
"}}"
